# Render supplies PORT automatically. Locally, use 5000.
PORT=5000
# Set to production on Render/Railway.
NODE_ENV=production
# MongoDB Atlas: mongodb+srv://<db-user>:<db-password>@<cluster>/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/rizmern?retryWrites=true&w=majority
# Generate a unique secret of at least 32 characters; never reuse this example.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Comma-separated exact browser origins (no trailing slash).
CLIENT_URL=https://www.rizmern.com,https://rizmern.com
# Set these for the one-time `npm run seed:admin` command.
ADMIN_NAME=RizMern Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-of-at-least-12-characters
